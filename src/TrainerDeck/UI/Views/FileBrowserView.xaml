<UserControl x:Class="TrainerDeck.UI.Views.FileBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TrainerDeck.UI.Controls"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid MaxWidth="1000" Margin="40,30,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,20,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Focusable="False" Margin="-6,0,8,0"
                    Command="{Binding GoBackCommand}" ToolTip="Cancel (Esc)">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" FontSize="28" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding Body}" Style="{StaticResource TextSecondary}" FontSize="14" Margin="4,8,20,0"
                   TextWrapping="Wrap" Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />

        <!-- Address bar: up, path, Windows file dialog -->
        <DockPanel Grid.Row="2" Margin="4,16,20,8">
            <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Focusable="False" Width="40" Padding="0" Margin="0,0,8,0"
                    Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}" ToolTip="Up a folder (Backspace)">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="14" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Focusable="False" Margin="8,0,0,0"
                    Command="{Binding BrowseSystemCommand}" ToolTip="Pick with File Explorer instead">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Browse…" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBox x:Name="PathBox" Style="{StaticResource FluentTextBox}" Height="40" FontSize="14" Padding="6,0"
                     VerticalContentAlignment="Center" Tag="{Binding PathPlaceholder}"
                     Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ctrl+L, then Enter to go" />
        </DockPanel>

        <controls:RowListBox Grid.Row="3" Style="{StaticResource RowListBox}"
                             ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=OneWay}" />
    </Grid>
</UserControl>
