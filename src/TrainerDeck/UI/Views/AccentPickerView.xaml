<UserControl x:Class="TrainerDeck.UI.Views.AccentPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="60,60,60,24" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" FontSize="32" />
            <TextBlock Style="{StaticResource TextSecondary}" FontSize="16" Margin="0,12,0,28">
                <Run Text="Windows colours. Current:" /> <Run Text="{Binding CurrentHex, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Focusable="False" Cursor="Hand" Margin="4"
                                Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Ring" Width="64" Height="64" CornerRadius="8" BorderThickness="3"
                                            BorderBrush="Transparent" Padding="3">
                                        <Border CornerRadius="5" Background="{Binding Brush}">
                                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                       Foreground="{Binding CheckBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource FlatButton}" Focusable="False" HorizontalAlignment="Left" Margin="4,24,0,0"
                    Command="{Binding EnterCustomCommand}" Content="Custom colour…" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
