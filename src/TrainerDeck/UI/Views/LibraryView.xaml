<UserControl x:Class="TrainerDeck.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:TrainerDeck.UI"
             xmlns:controls="clr-namespace:TrainerDeck.UI.Controls"
             xmlns:vm="clr-namespace:TrainerDeck.UI.ViewModels"
             xmlns:lib="clr-namespace:TrainerDeck.Core.Library;assembly=TrainerDeck.Core">
    <UserControl.Resources>
        <ui:EnumEqualsConverter x:Key="EnumEquals" />
        <ui:RailItemHeightConverter x:Key="RailItemHeight" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Margin="40,22,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/Logo.png" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Trainer Deck" Style="{StaticResource TextTitle}" FontSize="20" />
                    <TextBlock Style="{StaticResource TextSecondary}" FontSize="13">
                        <Run Text="{Binding Summary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SortLabel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="-12,10,0,0">
                <RadioButton Style="{StaticResource SelectorTab}" GroupName="LibraryTabs" Content="All" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=all}"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static lib:LibraryTab.All}}" />
                <RadioButton Style="{StaticResource SelectorTab}" GroupName="LibraryTabs" Content="Favourites" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=favourites}"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static lib:LibraryTab.Favourites}}" />
                <RadioButton Style="{StaticResource SelectorTab}" GroupName="LibraryTabs" Content="Recent" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=recent}"
                             IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static lib:LibraryTab.Recent}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0" Command="{Binding OpenZipsCommand}" Focusable="False"
                        ToolTip="{Binding PendingZipsLabel}" Visibility="{Binding HasPendingZips, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xF012;" FontSize="15" Foreground="{DynamicResource TextOnAccentBrush}" />
                        <TextBlock Text="{Binding PendingZipCount}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Border CornerRadius="6" Padding="2" Margin="-2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeaderFocus}" Value="search">
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="220" Tag="Search trainers"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>

                <!-- Command bar -->
                <Border Margin="8,0,0,0" Padding="1" CornerRadius="8" Height="40" Background="{DynamicResource LayerFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SubtleButton}" Height="36" Command="{Binding CycleSortCommand}" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=sort}" ToolTip="Change sort order (Ctrl+S)" Focusable="False">
                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphSort}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Height="36" Command="{Binding RescanCommand}" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=rescan}" ToolTip="Rescan (F5)" Focusable="False">
                            <TextBlock x:Name="RefreshGlyph" Text="{StaticResource GlyphRefresh}" FontSize="16"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Spin">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360"
                                                                             Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Spin" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Height="36" Command="{Binding AddTrainerCommand}" ToolTip="Add a trainer (from Downloads)" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=add}" Focusable="False">
                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphAdd}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Height="36" Command="{Binding OpenFolderCommand}" ToolTip="Open trainer folder" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=folder}" Focusable="False">
                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphFolder}" FontSize="16" />
                        </Button>
                        <Rectangle Width="1" Margin="4,9" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <Button Style="{StaticResource SubtleButton}" Height="36" Command="{Binding OpenSettingsCommand}" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=settings}" ToolTip="Settings (Ctrl+,)" Focusable="False">
                            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphSettings}" FontSize="16" />
                        </Button>
                        <Button Height="36" Focusable="False"
                                Command="{Binding DataContext.ToggleFullScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=fullscreen}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                    <Setter Property="ToolTip" Value="Full screen (F11)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsFullScreen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="ToolTip" Value="Exit full screen (F11)" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE740;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsFullScreen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Text" Value="&#xE73F;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Rectangle Width="1" Margin="4,9" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        <Button Style="{StaticResource SubtleButton}" Height="36" Focusable="False" ToolTip="Close Trainer Deck"
                                Command="{Binding DataContext.RequestCloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" Tag="{Binding HeaderFocus, Converter={StaticResource EnumEquals}, ConverterParameter=close}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Card grid -->
        <ListBox x:Name="CardList" Grid.Row="1"
                 ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource CardItemStyle}"
                 Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                 KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.TabNavigation="None"
                 MouseDoubleClick="OnCardDoubleClick"
                 PreviewMouseRightButtonUp="OnCardRightClick">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <!-- Spacing lives inside the scrolled content so the scaled focus ring is never clipped. -->
                    <ScrollViewer x:Name="Scroller" Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                        <ItemsPresenter Margin="40,14,40,36" />
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:CardGridPanel MinItemWidth="170" MaxItemWidth="230" Spacing="24" AspectRatio="1.4" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource TextTitle}" FontSize="26" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource TextSecondary}" FontSize="15" Margin="0,10,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0"
                        Visibility="{Binding ShowOpenFolder, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource AccentButton}" Command="{Binding AddTrainerCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphAdd}" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource TextOnAccentBrush}" />
                        <TextBlock Text="Add a trainer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Margin="12,0,0,0" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphFolder}" FontSize="15" Margin="0,0,8,0" />
                        <TextBlock Text="Open trainers folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- A–Z rail: shown while a shoulder button is held -->
        <Grid Grid.Row="1" x:Name="Rail" Opacity="0" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRailOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.167" EasingFunction="{StaticResource FluentAccelerate}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Rectangle Fill="{DynamicResource ScrimBrush}" />
            <Border Width="160" Height="160" CornerRadius="8" Background="{DynamicResource SurfaceHighBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="{DynamicResource ShadowOpacityHigh}" />
                </Border.Effect>
                <TextBlock Text="{Binding RailLetter}" Style="{StaticResource TextTitle}" FontSize="92" Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-8,0,0" />
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0" Padding="6,10"
                    Background="{DynamicResource SurfaceHighBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ItemsControl ItemsSource="{Binding RailLetters}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RailLetterViewModel}">
                            <Grid Width="32" Height="{Binding ActualHeight, ElementName=Rail, Converter={StaticResource RailItemHeight}}">
                                <Border x:Name="Dot" Width="28" Height="28" CornerRadius="4" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                <TextBlock x:Name="Letter" Text="{Binding Text}" Style="{StaticResource TextBase}" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Opacity="0.5" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                    <Setter TargetName="Letter" Property="Opacity" Value="1" />
                                    <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                    <Setter TargetName="Letter" Property="Opacity" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
