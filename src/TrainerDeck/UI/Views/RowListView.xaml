<UserControl x:Class="TrainerDeck.UI.Views.RowListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TrainerDeck.UI.Controls"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid MaxWidth="1000" Margin="40,34,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,20,10">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Focusable="False" Margin="-6,0,8,0"
                        Command="{Binding GoBackCommand}" ToolTip="Back (Esc)"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" FontSize="28" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextSecondary}" FontSize="14" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Body}" Style="{StaticResource TextSecondary}" FontSize="16" Margin="0,18,0,4" LineHeight="25"
                       TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                       Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <controls:RowListBox Grid.Row="1" Style="{StaticResource RowListBox}"
                             ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=OneWay}" />
    </Grid>
</UserControl>
