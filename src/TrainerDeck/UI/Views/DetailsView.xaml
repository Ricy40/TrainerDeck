<UserControl x:Class="TrainerDeck.UI.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TrainerDeck.UI.Controls"
             xmlns:vm="clr-namespace:TrainerDeck.UI.ViewModels"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid ClipToBounds="True">
        <!-- Hero art (Steam) fading into the background -->
        <Grid VerticalAlignment="Top" Height="460">
            <Image Source="{Binding Hero}" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.45" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#400D0F13" Offset="0" />
                        <GradientStop Color="#B00D0F13" Offset="0.6" />
                        <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid Margin="60,44,60,0" MaxWidth="1400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cover -->
            <Grid Width="280" Height="392" VerticalAlignment="Top" Margin="0,0,48,0" DataContext="{Binding Card}">
                <Border x:Name="CoverMask" CornerRadius="16" Background="White" />
                <Grid>
                    <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=CoverMask}" />
                    </Grid.OpacityMask>
                    <Rectangle Fill="{Binding ArtBackground}" />
                    <TextBlock Text="{Binding Initial}" Style="{StaticResource TextTitle}" FontSize="110" Opacity="0.85"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding DisplayIcon, Converter={StaticResource NullToVisibilityInverse}}" />
                    <Image x:Name="IconImage" Source="{Binding DisplayIcon}" Width="128" Height="128" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.45" />
                        </Image.Effect>
                    </Image>
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <Border Background="{StaticResource RunningBrush}" CornerRadius="8" Padding="10,4" Margin="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Running" Style="{StaticResource TextBase}" FontSize="13" FontWeight="Bold" Foreground="#05210F" />
                </Border>
                <Grid.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" />
                </Grid.Effect>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="20,0,20,8">
                    <Grid>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" FontSize="38" TextWrapping="Wrap"
                                   Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}"
                                   x:Name="TitleText" />
                        <TextBox x:Name="RenameBox" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="32" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" Padding="12,6"
                                 Background="{StaticResource SurfaceHighBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentBrush}" SelectionBrush="{StaticResource AccentBrush}"
                                 BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextSecondary}" FontSize="17" Margin="0,8,0,0"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Info}" Margin="0,20,0,6" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InfoLine}">
                                <StackPanel Margin="0,0,36,12" MaxWidth="420">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource TextSecondary}" FontSize="12" Typography.Capitals="AllSmallCaps" />
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource TextBase}" FontSize="15" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <controls:RowListBox Grid.Row="1" Style="{StaticResource RowListBox}" MaxWidth="760" HorizontalAlignment="Left"
                                     ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
