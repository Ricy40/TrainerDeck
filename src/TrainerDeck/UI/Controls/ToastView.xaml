<UserControl x:Class="TrainerDeck.UI.Controls.ToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Bottom" HorizontalAlignment="Center" IsHitTestVisible="False" Focusable="False">
    <!-- Fluent InfoBar, floating above the footer -->
    <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="40,0,40,20" MaxWidth="900" MinHeight="48"
            CornerRadius="8" Padding="16,12" BorderThickness="1" IsHitTestVisible="False" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform Y="16" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="{DynamicResource ShadowOpacityHigh}" />
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceHighBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMessageVisible}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.167" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.25"
                                                     EasingFunction="{StaticResource FluentDecelerate}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.167" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="16" Duration="0:0:0.167"
                                                     EasingFunction="{StaticResource FluentAccelerate}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <!-- Severity icon: a filled circle with the glyph cut out of it -->
            <Grid Width="20" Height="20" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock x:Name="IconBack" Text="&#xF136;" FontFamily="{StaticResource IconFont}" FontSize="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xF13F;" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Text" Value="&#xF13D;" />
                                    <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Text="{Binding Message}" Style="{StaticResource TextBase}" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="820" />
        </StackPanel>
    </Border>
</UserControl>
