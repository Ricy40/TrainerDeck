<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TrainerDeck.UI.ViewModels"
                    xmlns:views="clr-namespace:TrainerDeck.UI.Views">
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
        <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DetailsViewModel}">
        <views:DetailsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:IgnorePatternsViewModel}">
        <views:IgnorePatternsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TextEntryViewModel}">
        <views:TextEntryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccentPickerViewModel}">
        <views:AccentPickerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RowListPageViewModel}">
        <views:RowListView />
    </DataTemplate>
</ResourceDictionary>
