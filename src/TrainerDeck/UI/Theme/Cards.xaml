<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TrainerDeck.UI.ViewModels">

    <!-- Container: focus ring + scale-up when selected (= focused card), softer ring on hover. -->
    <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Panel.ZIndex" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="HoverRing" Margin="-5" CornerRadius="19" BorderThickness="3"
                                BorderBrush="{StaticResource TextTertiaryBrush}" Opacity="0" />
                        <Border x:Name="FocusRing" Margin="-6" CornerRadius="20" BorderThickness="3"
                                BorderBrush="{StaticResource AccentBrush}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Glow" Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverRing" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.06" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.06" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card content -->
    <DataTemplate DataType="{x:Type vm:TrainerCardViewModel}">
        <Grid>
            <Border x:Name="Mask" CornerRadius="14" Background="White" />
            <Grid>
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=Mask}" />
                </Grid.OpacityMask>

                <Rectangle Fill="{Binding ArtBackground}" />

                <Image x:Name="CoverImage" Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Exe icon, centred in the upper part of the card -->
                <Grid x:Name="IconArea" VerticalAlignment="Top" Margin="0,34,0,0" HorizontalAlignment="Center">
                    <Image x:Name="IconImage" Source="{Binding Icon}" Width="104" Height="104"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
                        </Image.Effect>
                    </Image>
                    <TextBlock x:Name="Initial" Text="{Binding Initial}" Style="{StaticResource TextTitle}" FontSize="64"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85" Visibility="Collapsed" />
                </Grid>

                <Rectangle Fill="{StaticResource CardScrimBrush}" VerticalAlignment="Bottom" Height="130" />

                <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,14">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="46" LineHeight="22" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Badges -->
                <Border Background="{StaticResource BadgeBrush}" CornerRadius="8" Padding="8,3" Margin="10"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding OptionsBadge}" Style="{StaticResource TextBase}" FontSize="13" FontWeight="SemiBold" />
                </Border>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                    <Border Background="{StaticResource BadgeBrush}" CornerRadius="8" Padding="6,4" HorizontalAlignment="Left"
                            Visibility="{Binding IsFavourite, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphStarFill}" FontSize="14" Foreground="{StaticResource FavouriteBrush}" />
                    </Border>
                    <Border Background="{StaticResource RunningBrush}" CornerRadius="8" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Running" Style="{StaticResource TextBase}" FontSize="12" FontWeight="Bold" Foreground="#05210F" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasCover}" Value="True">
                <Setter TargetName="IconArea" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Initial" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
