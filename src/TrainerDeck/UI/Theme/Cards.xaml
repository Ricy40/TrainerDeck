<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TrainerDeck.UI.ViewModels">

    <!-- Container: elevation shadow, Fluent focus ring and a scale-up on the selected (focused) card. -->
    <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Panel.ZIndex" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Elevation" CornerRadius="8" Background="Black" Margin="1">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Shadow" BlurRadius="14" ShadowDepth="3" Direction="270" Color="Black"
                                                  Opacity="{DynamicResource ShadowOpacity}" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter />
                        <Border x:Name="HoverRing" Margin="-3" CornerRadius="11" BorderThickness="2"
                                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="FocusRing" Margin="-4" CornerRadius="12" BorderThickness="3" Opacity="0" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}">
                            <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Setter TargetName="HoverRing" Property="Opacity" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.167"
                                                         EasingFunction="{StaticResource FluentDecelerate}" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.167"
                                                         EasingFunction="{StaticResource FluentDecelerate}" />
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="BlurRadius" To="32" Duration="0:0:0.167"
                                                         EasingFunction="{StaticResource FluentDecelerate}" />
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="ShadowDepth" To="10" Duration="0:0:0.167"
                                                         EasingFunction="{StaticResource FluentDecelerate}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.1"
                                                         EasingFunction="{StaticResource FluentAccelerate}" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.1"
                                                         EasingFunction="{StaticResource FluentAccelerate}" />
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083" />
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="ShadowDepth" To="3" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card content -->
    <DataTemplate DataType="{x:Type vm:TrainerCardViewModel}">
        <Grid>
            <Border x:Name="Mask" CornerRadius="8" Background="White" />
            <Grid>
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=Mask}" />
                </Grid.OpacityMask>

                <Rectangle Fill="{Binding ArtBackground}" />

                <Image x:Name="CoverImage" Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Exe icon, centred in the upper part of the card -->
                <Grid x:Name="IconArea" VerticalAlignment="Top" Margin="0,34,0,0" HorizontalAlignment="Center">
                    <Image x:Name="IconImage" Source="{Binding DisplayIcon}" Width="104" Height="104"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
                        </Image.Effect>
                    </Image>
                    <TextBlock x:Name="Initial" Text="{Binding Initial}" Style="{StaticResource TextTitle}" FontSize="64" Foreground="{StaticResource OnImageTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85" Visibility="Collapsed" />
                </Grid>

                <Rectangle Fill="{StaticResource CardScrimBrush}" VerticalAlignment="Bottom" Height="130" />

                <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,14">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBase}" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource OnImageTextBrush}"
                               FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="46" LineHeight="22" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" Foreground="{StaticResource OnImageTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Visibility="{Binding HasVersion, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Badges -->
                <Border Background="{StaticResource BadgeBrush}" CornerRadius="4" Padding="7,2,7,3" Margin="8"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding OptionsBadge}" Style="{StaticResource TextBase}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OnImageTextBrush}" />
                </Border>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                    <!-- Favourite star: always shown (filled yellow) on favourites, otherwise on hover or when selected -->
                    <Button x:Name="StarButton" Focusable="False" Cursor="Hand" HorizontalAlignment="Left" Opacity="0"
                            Command="{Binding DataContext.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" ToolTip="Favourite (Ctrl+D)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource BadgeBrush}" CornerRadius="4" Width="30" Height="30">
                                    <Grid>
                                        <TextBlock x:Name="Outline" Style="{StaticResource Glyph}" Text="{StaticResource GlyphStar}" FontSize="15"
                                                   HorizontalAlignment="Center" Foreground="{StaticResource OnImageTextBrush}" />
                                        <TextBlock x:Name="Fill" Style="{StaticResource Glyph}" Text="{StaticResource GlyphStarFill}" FontSize="15"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource FavouriteBrush}" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E6000000" />
                                        <Setter TargetName="Outline" Property="Foreground" Value="{DynamicResource FavouriteBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                        <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Background="{DynamicResource RunningBrush}" CornerRadius="4" Padding="7,2,7,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Running" Style="{StaticResource TextBase}" FontSize="12" FontWeight="Bold" Foreground="#05210F" />
                    </Border>
                </StackPanel>
            </Grid>
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" IsHitTestVisible="False" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                <Setter TargetName="StarButton" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="StarButton" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="StarButton" Property="Opacity" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasCover}" Value="True">
                <Setter TargetName="IconArea" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DisplayIcon}" Value="{x:Null}">
                <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Initial" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
