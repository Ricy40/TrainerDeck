<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:TrainerDeck.UI">

    <!-- Palette: near-black blue-greys, one cool accent, warm gold for favourites, green for running. -->
    <Color x:Key="BackgroundColor">#0D0F13</Color>
    <Color x:Key="SurfaceColor">#151820</Color>
    <Color x:Key="SurfaceHighColor">#1E222D</Color>
    <Color x:Key="SurfaceHigherColor">#272C3A</Color>
    <Color x:Key="BorderColor">#2C3240</Color>
    <Color x:Key="TextPrimaryColor">#F3F5F9</Color>
    <Color x:Key="TextSecondaryColor">#A3AAB8</Color>
    <Color x:Key="TextTertiaryColor">#6E7686</Color>
    <Color x:Key="AccentColor">#4CC2FF</Color>
    <Color x:Key="AccentDimColor">#1F4A63</Color>
    <Color x:Key="FavouriteColor">#FFC83D</Color>
    <Color x:Key="RunningColor">#3DDC84</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHighColor}" />
    <SolidColorBrush x:Key="SurfaceHigherBrush" Color="{StaticResource SurfaceHigherColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="FavouriteBrush" Color="{StaticResource FavouriteColor}" />
    <SolidColorBrush x:Key="RunningBrush" Color="{StaticResource RunningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#B8000000" />

    <LinearGradientBrush x:Key="CardScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.45" Color="#99000000" />
        <GradientStop Offset="1" Color="#EB000000" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Segoe Fluent Icons code points -->
    <sys:String x:Key="GlyphSearch">&#xE721;</sys:String>
    <sys:String x:Key="GlyphRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="GlyphSettings">&#xE713;</sys:String>
    <sys:String x:Key="GlyphSort">&#xE8CB;</sys:String>
    <sys:String x:Key="GlyphStarFill">&#xE735;</sys:String>
    <sys:String x:Key="GlyphStar">&#xE734;</sys:String>
    <sys:String x:Key="GlyphFolder">&#xE8B7;</sys:String>
    <sys:String x:Key="GlyphPlay">&#xE768;</sys:String>
    <sys:String x:Key="GlyphClear">&#xE711;</sys:String>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <ui:NullToVisibilityConverter x:Key="NullToVisibility" />
    <ui:NullToVisibilityConverter x:Key="NullToVisibilityInverse" Invert="True" />
    <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <sys:Double x:Key="PageGutter">40</sys:Double>
    <Thickness x:Key="PageGutterThickness">40,0,40,0</Thickness>
</ResourceDictionary>
