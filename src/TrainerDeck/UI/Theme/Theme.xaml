<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:TrainerDeck.UI">

    <!-- Theme colours (Background, Surface, Text*, Accent, ...) are supplied at runtime by ThemeManager. -->

    <!-- Text and badges that sit on game artwork stay light in every theme. -->
    <SolidColorBrush x:Key="OnImageTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnImageTextSecondaryBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="BadgeBrush" Color="#B8000000" />

    <LinearGradientBrush x:Key="CardScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.45" Color="#99000000" />
        <GradientStop Offset="1" Color="#EB000000" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Segoe Fluent Icons code points -->
    <sys:String x:Key="GlyphSearch">&#xE721;</sys:String>
    <sys:String x:Key="GlyphRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="GlyphSettings">&#xE713;</sys:String>
    <sys:String x:Key="GlyphSort">&#xE8CB;</sys:String>
    <sys:String x:Key="GlyphStarFill">&#xE735;</sys:String>
    <sys:String x:Key="GlyphStar">&#xE734;</sys:String>
    <sys:String x:Key="GlyphFolder">&#xE8B7;</sys:String>
    <sys:String x:Key="GlyphPlay">&#xE768;</sys:String>
    <sys:String x:Key="GlyphClear">&#xE711;</sys:String>

    <sys:String x:Key="GlyphAdd">&#xE710;</sys:String>

    <!-- Fluent motion: decelerate for things arriving, accelerate for things leaving -->
    <QuinticEase x:Key="FluentDecelerate" EasingMode="EaseOut" />
    <CubicEase x:Key="FluentAccelerate" EasingMode="EaseIn" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <ui:NullToVisibilityConverter x:Key="NullToVisibility" />
    <ui:NullToVisibilityConverter x:Key="NullToVisibilityInverse" Invert="True" />
    <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <sys:Double x:Key="PageGutter">40</sys:Double>
    <Thickness x:Key="PageGutterThickness">40,0,40,0</Thickness>
</ResourceDictionary>
