<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TrainerDeck.UI.ViewModels">

    <!-- Row container: selection is driven by the view model, so items never take keyboard focus. -->
    <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="12" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsSelectable}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHighBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RowItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="Scroller" Focusable="False" Padding="0">
                        <ItemsPresenter Margin="4,4,16,24" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared left part of a row: glyph, label, detail -->
    <DataTemplate x:Key="RowText" DataType="{x:Type vm:RowViewModel}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="20" Width="40"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" Style="{StaticResource TextBase}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0"
                           TextWrapping="Wrap" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HeaderRow}">
        <TextBlock Text="{Binding Label}" Style="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold"
                   Margin="14,22,0,4" Typography.Capitals="AllSmallCaps" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ActionRow}">
        <Grid x:Name="Root" Margin="16,12">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter TargetName="Root" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToggleRow}">
        <Grid x:Name="Root" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" Margin="0,0,24,0" />
            <Border x:Name="Track" Grid.Column="1" Width="48" Height="26" CornerRadius="13" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceHigherBrush}" BorderBrush="{DynamicResource TextTertiaryBrush}" BorderThickness="1">
                <Ellipse x:Name="Knob" Width="18" Height="18" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Value}" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource BackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Cheat: hotkey chip, name, value, controller shortcut, on/off switch -->
    <DataTemplate DataType="{x:Type vm:CheatRow}">
        <Grid x:Name="Root" Margin="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource SurfaceHigherBrush}" CornerRadius="6" Padding="8,3"
                    Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding Label}" Style="{StaticResource TextBase}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,12,0"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding HasShortcut, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" /><Run Text="  " /><Run Text="{Binding ShortcutText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Padding="12,4" CornerRadius="8"
                    Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Value}" Style="{StaticResource TextBase}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" MinWidth="44" TextAlignment="Center" />
            </Border>
            <Grid Grid.Column="3" Width="48" VerticalAlignment="Center">
                <Border x:Name="Track" Width="48" Height="26" CornerRadius="13"
                        Background="{DynamicResource SurfaceHigherBrush}" BorderBrush="{DynamicResource TextTertiaryBrush}" BorderThickness="1">
                    <Ellipse x:Name="Knob" Width="18" Height="18" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <TextBlock x:Name="ActionGlyph" Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="18" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOn}" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource BackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKnown}" Value="False">
                <Setter TargetName="Track" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChoiceRow}">
        <Grid Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowText}" Margin="0,0,24,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ValueText}" Style="{StaticResource TextBase}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" MinWidth="150" TextAlignment="Center" Margin="10,0" />
                <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
