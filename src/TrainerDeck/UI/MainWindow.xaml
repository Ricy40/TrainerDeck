<Window x:Class="TrainerDeck.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TrainerDeck.UI"
        xmlns:vm="clr-namespace:TrainerDeck.UI.ViewModels"
        xmlns:views="clr-namespace:TrainerDeck.UI.Views"
        xmlns:controls="clr-namespace:TrainerDeck.UI.Controls"
        Title="Trainer Deck" Width="1280" Height="800" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Focusable="False" RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
        </ContentControl>

        <controls:ToastView />

        <!-- Footer: context button hints -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Height="56" Padding="40,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:HintsBar Grid.Column="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
