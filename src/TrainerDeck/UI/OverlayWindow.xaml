<Window x:Class="TrainerDeck.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TrainerDeck.UI.Controls"
        Title="Trainer Deck overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="Panel" HorizontalAlignment="Right" Width="620" Margin="0,12,12,12" CornerRadius="8"
            Background="{DynamicResource OverlayPanelBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="12" Direction="270" Opacity="{DynamicResource ShadowOpacityHigh}" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="24,18,24,0">
                <Image Source="/Assets/Logo.png" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Trainer Deck" Style="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="SwitchHint" Text="  ·  LB / RB: other trainer" Style="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" Margin="-20,-10,-20,0" />
            <controls:ToastView Grid.Row="1" />

            <Border Grid.Row="2" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,7,7" Padding="20,0" Height="56">
                <controls:HintsBar />
            </Border>
        </Grid>
    </Border>
</Window>
