<Application x:Class="TrainerDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Theme/Theme.xaml" />
                <ResourceDictionary Source="UI/Theme/Controls.xaml" />
                <ResourceDictionary Source="UI/Theme/Cards.xaml" />
                <ResourceDictionary Source="UI/Theme/Rows.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
