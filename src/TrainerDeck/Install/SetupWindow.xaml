<Window x:Class="TrainerDeck.Install.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Trainer Deck" Width="640" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Fluent check box -->
        <Style x:Key="SetupCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" VerticalAlignment="Top" Margin="0,0,12,0"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Top" Margin="0,1,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent progress bar: a 1 px track with a 3 px accent indicator -->
        <Style x:Key="SetupProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Height="1" CornerRadius="0.5" Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" />
                            <Border x:Name="Runner" Width="140" HorizontalAlignment="Left" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-140" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Run">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="RenderTransform.X"
                                                             From="-140" To="600" Duration="0:0:1.6">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Run" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Maintenance choice: a Windows 11 Settings-style card -->
        <Style x:Key="OptionCard" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" Padding="16,12" MinHeight="68"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Padding" Value="15,11" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="32,28,32,0">
            <Image x:Name="Logo" Width="48" Height="48" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Install Trainer Deck" Style="{StaticResource TextTitle}" FontSize="24" />
                <TextBlock x:Name="VersionText" Style="{StaticResource TextSecondary}" FontSize="13" Margin="0,2,0,0" MaxWidth="480" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <!-- Existing install found: what to do -->
        <StackPanel x:Name="MaintenancePanel" Grid.Row="1" Margin="32,24,32,0" Visibility="Collapsed">
            <Button x:Name="UpdateCard" Style="{StaticResource OptionCard}" Tag="&#xE895;" Click="OnChooseUpdate">
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource TextBase}" FontSize="15" />
                    <TextBlock x:Name="UpdateDetail" Style="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button x:Name="RepairCard" Style="{StaticResource OptionCard}" Tag="&#xE90F;" Click="OnChooseRepair">
                <StackPanel>
                    <TextBlock Text="Repair" Style="{StaticResource TextBase}" FontSize="15" />
                    <TextBlock x:Name="RepairDetail" Style="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Reinstalls Trainer Deck and resets its shortcuts, the no-UAC start, the trainerdeck: link and the Game Bar widget. Settings and trainers are kept." />
                </StackPanel>
            </Button>
            <Button x:Name="UninstallCard" Style="{StaticResource OptionCard}" Tag="&#xE74D;" Click="OnChooseUninstall">
                <StackPanel>
                    <TextBlock Text="Uninstall" Style="{StaticResource TextBase}" FontSize="15" />
                    <TextBlock Style="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Removes Trainer Deck from this PC. You choose whether your trainers and settings go too." />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Install, update or repair options -->
        <StackPanel x:Name="OptionsPanel" Grid.Row="1" Margin="32,24,32,0">
            <TextBlock Text="Install location" Style="{StaticResource TextBase}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,24">
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Height="36" Margin="8,0,0,0" Content="Change…" Click="OnBrowse" />
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Height="36" Padding="12,0">
                    <TextBlock x:Name="TargetText" Style="{StaticResource TextBase}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
            </DockPanel>

            <CheckBox x:Name="TaskCheck" Style="{StaticResource SetupCheck}" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="Start as administrator without a UAC prompt (recommended)" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Needed for the Cheats panel and overlay. Uses a Task Scheduler entry that only this installed copy can use." />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="DesktopCheck" Style="{StaticResource SetupCheck}" Content="Desktop shortcut" />
            <CheckBox x:Name="WidgetCheck" Style="{StaticResource SetupCheck}" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="Xbox Game Bar widget" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Control your trainer's cheats from Game Bar (Xbox button or Win + G). Adds the widget's signing certificate to this PC's trusted people." />
                </StackPanel>
            </CheckBox>
            <TextBlock x:Name="OptionsNote" Style="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Your trainers go in the Trainers folder inside the install location. Use “Add a trainer” in the app to copy them there." />
        </StackPanel>

        <!-- Uninstall choices -->
        <StackPanel x:Name="UninstallPanel" Grid.Row="1" Margin="32,24,32,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,24"
                       Text="Removes the app, its shortcuts, the no-UAC start entry, the trainerdeck: link, and the Game Bar widget with its certificate." />
            <CheckBox x:Name="DeleteTrainersCheck" Style="{StaticResource SetupCheck}">
                <StackPanel>
                    <TextBlock Text="Also delete the Trainers folder" TextWrapping="Wrap" />
                    <TextBlock x:Name="TrainersDetail" Style="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="DeleteDataCheck" Style="{StaticResource SetupCheck}" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="Also delete settings, library and art cache" TextWrapping="Wrap" />
                    <TextBlock x:Name="DataDetail" Style="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </CheckBox>
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Grid.Row="1" Margin="32,40,32,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" Style="{StaticResource TextBase}" FontSize="15" TextWrapping="Wrap" />
            <ProgressBar x:Name="Bar" Style="{StaticResource SetupProgress}" IsIndeterminate="True" Margin="0,18,0,0" />
        </StackPanel>

        <!-- Command area, as in Windows 11 dialogs -->
        <Border Grid.Row="2" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="24">
            <DockPanel>
            <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="Back" Click="OnBack" MinWidth="100" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource FlatButton}" Content="Cancel" Click="OnCancel" Margin="0,0,8,0" MinWidth="120" />
                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Content="Install" Click="OnPrimary" MinWidth="120" IsDefault="True" />
            </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
