<Window x:Class="TrainerDeck.Install.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Trainer Deck" Width="640" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SetupCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" VerticalAlignment="Top" Margin="0,1,12,0"
                                    Background="{StaticResource SurfaceHigherBrush}" BorderBrush="{StaticResource TextTertiaryBrush}" BorderThickness="1">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Foreground="#06121A"
                                           HorizontalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="36,30,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image x:Name="Logo" Width="56" Height="56" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Heading" Text="Install Trainer Deck" Style="{StaticResource TextTitle}" FontSize="26" />
                <TextBlock x:Name="VersionText" Style="{StaticResource TextSecondary}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="OptionsPanel" Grid.Row="1" Margin="0,28,0,0">
            <TextBlock Text="Install location" Style="{StaticResource TextSecondary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,24">
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="10,0,0,0" Content="Change…" Click="OnBrowse" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,9">
                    <TextBlock x:Name="TargetText" Style="{StaticResource TextBase}" FontSize="14" TextTrimming="CharacterEllipsis" />
                </Border>
            </DockPanel>

            <CheckBox x:Name="TaskCheck" Style="{StaticResource SetupCheck}" IsChecked="True">
                <StackPanel>
                    <TextBlock Text="Start as administrator without a UAC prompt (recommended)" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="Needed for the Cheats panel and overlay. Uses a Task Scheduler entry that only this installed copy can use." />
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="DesktopCheck" Style="{StaticResource SetupCheck}" Content="Desktop shortcut" />
            <TextBlock Style="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Your trainers go in the Trainers folder inside the install location. Use “Add a trainer” in the app to copy them there." />
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Grid.Row="1" Margin="0,40,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" Style="{StaticResource TextBase}" FontSize="16" TextWrapping="Wrap" />
            <ProgressBar x:Name="Bar" IsIndeterminate="True" Height="4" Margin="0,18,0,0" Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource SurfaceHighBrush}" BorderThickness="0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Style="{StaticResource FlatButton}" Content="Cancel" Click="OnCancel" Margin="0,0,10,0" />
            <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Content="Install" Click="OnInstall" Padding="24,10" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
