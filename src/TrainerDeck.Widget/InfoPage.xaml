<Page
    x:Class="TrainerDeck.Widget.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel Margin="32" MaxWidth="520" VerticalAlignment="Center">
        <TextBlock Text="Trainer Deck widget" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}"
                   Text="This widget lives in Xbox Game Bar. Press the Xbox button (or Win + G), open the widget menu and choose Trainer Deck." />
    </StackPanel>
</Page>
