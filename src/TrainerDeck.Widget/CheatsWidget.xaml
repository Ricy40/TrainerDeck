<Page
    x:Class="TrainerDeck.Widget.CheatsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent">

    <!-- Game Bar's own widget colours (sampled from Capture and Audio): body, control fill, divider. -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="WidgetControlBrush" Color="#37383B" />
                    <SolidColorBrush x:Key="WidgetDividerBrush" Color="#45484B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WidgetControlBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WidgetDividerBrush" Color="#DADCE0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <!-- Laid out like Game Bar's own widgets: Game Bar draws the title bar, the widget a compact, translucent body. -->
    <Grid x:Name="Root" Padding="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Padding="8,6,8,10" BorderBrush="{ThemeResource WidgetDividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TrainerText" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <muxc:InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" IsClosable="False" Margin="4,4,4,4" />

        <ListView x:Name="Rows" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnRowClick" KeyDown="OnRowKeyDown" XYFocusKeyboardNavigation="Enabled" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Opacity="{Binding ItemOpacity}">
                        <!-- Section heading like Audio's "Default devices": a divider above, bold text -->
                        <Border Visibility="{Binding HeaderVisibility}" Margin="-8,6,-8,0" Padding="8,12,8,4"
                                BorderBrush="{ThemeResource WidgetDividerBrush}" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding Label}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </Border>
                        <Grid Visibility="{Binding ItemVisibility}" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyTextBlockStyle}" />
                                <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" TextTrimming="CharacterEllipsis"
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Value with d-pad arrows when it can be stepped -->
                                <Border Visibility="{Binding ValueVisibility}" Padding="8,4" CornerRadius="4" MinWidth="56" Margin="0,0,8,0"
                                        Background="{ThemeResource WidgetControlBrush}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE76B;" FontSize="9" Visibility="{Binding StepperVisibility}" Margin="0,0,6,0"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Value}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="9" Visibility="{Binding StepperVisibility}" Margin="6,0,0,0"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <ToggleSwitch IsOn="{Binding IsOn}" Visibility="{Binding SwitchVisibility}" IsHitTestVisible="False" IsTabStop="False"
                                              OnContent="" OffContent="" MinWidth="0" Width="40" Margin="0,0,-2,0" />
                                <FontIcon Glyph="&#xE768;" FontSize="12" Visibility="{Binding GlyphVisibility}" Margin="0,0,6,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Pinned over a game: just what's switched on -->
        <TextBlock x:Name="PinnedEmpty" Grid.Row="2" Text="No cheats are on" Visibility="Collapsed" Margin="4,4,0,0"
                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Shown while Trainer Deck isn't running -->
        <StackPanel x:Name="OfflinePanel" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed" MaxWidth="300">
            <Image Source="ms-appx:///GameBar/Icon.png" Width="40" Height="40" HorizontalAlignment="Center" />
            <TextBlock Margin="0,12,0,0" Text="Trainer Deck isn't running" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="OfflineDetail" Margin="0,4,0,16" TextWrapping="Wrap" TextAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Open it, or keep it running in the tray, to control your trainer's cheats from here." />
            <Button x:Name="OpenButton" Content="Open Trainer Deck" HorizontalAlignment="Center" Click="OnOpenClick"
                    Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
