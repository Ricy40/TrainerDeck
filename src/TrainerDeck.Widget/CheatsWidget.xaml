<Page
    x:Class="TrainerDeck.Widget.CheatsWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TrainerText" Text="Trainer Deck" Style="{ThemeResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusText" Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,2,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Last message from Trainer Deck, like the app's InfoBar -->
        <Border x:Name="MessageBar" Grid.Row="1" Margin="0,10,0,0" Padding="12,8" CornerRadius="4" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" />
        </Border>

        <ListView x:Name="Rows" Grid.Row="2" Margin="-12,10,-12,0" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="OnRowClick" KeyDown="OnRowKeyDown" XYFocusKeyboardNavigation="Enabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="MinHeight" Value="44" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Opacity="{Binding ItemOpacity}">
                        <TextBlock Text="{Binding Label}" Visibility="{Binding HeaderVisibility}" Margin="0,14,0,4"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Grid Visibility="{Binding ItemVisibility}" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyTextBlockStyle}" />
                                <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" TextTrimming="CharacterEllipsis"
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"
                                           Visibility="{Binding StepperVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Visibility="{Binding ValueVisibility}" Margin="8,0" Padding="8,2" CornerRadius="4" MinWidth="44"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Value}" TextAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </Border>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Visibility="{Binding StepperVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ToggleSwitch IsOn="{Binding IsOn}" Visibility="{Binding SwitchVisibility}" IsHitTestVisible="False" IsTabStop="False"
                                              OnContent="" OffContent="" MinWidth="0" Width="44" />
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                                           Visibility="{Binding GlyphVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Shown while Trainer Deck isn't running -->
        <StackPanel x:Name="OfflinePanel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="320">
            <TextBlock Text="Trainer Deck isn't running" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" TextAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Open it, or keep it running in the tray, to control your trainer's cheats from here." />
            <Button x:Name="OpenButton" Content="Open Trainer Deck" HorizontalAlignment="Center" Click="OnOpenClick"
                    Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
